---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — splot" description="This page does not exist." noindex>
  <section class="hero">
    <p class="pill">
      <span class="dot"></span>Error 404
    </p>
    <h1 class="solo">This page does not exist.</h1>
    <p class="lead">The address is wrong, or the page was moved.</p>
    <p class="actions">
      <a class="btn" href="/">
        Go to the home page
      </a>
    </p>
  </section>
</BaseLayout>
