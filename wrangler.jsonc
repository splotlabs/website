{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "splot-website",
  "compatibility_date": "2026-11-20",
  // Static assets only. There is no Worker script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // The production origin. This is a Workers Custom Domain, not a route to another origin.
  "routes": [{ "pattern": "splotlabs.io", "custom_domain": true }],
  // The production workers.dev address is off. Branch Previews keep their workers.dev addresses.
  "workers_dev": false,
  "preview_urls": true,
  // Worker Previews use the same settings. This site has no bindings or variables.
  "previews": {},
}
